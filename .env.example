# ==========================================================
# SHIVKRUPA ART JEWELLERY — Configuration Template (.env.example)
# Copy this file to .env for local customization if desired.
# Note: For Docker deployment, docker-compose.yml already includes
# zero-config working defaults for immediate startup.
# ==========================================================

# Application Settings
APP_NAME="SHIVKRUPA ART JEWELLERY"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# ----------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------
# For Docker Deployment (optional overrides for docker-compose.yml):
DB_HOST=db
DB_PORT=3306
DB_NAME=shivkrupa_db
DB_USER=shivkrupa_user
DB_PASSWORD=your_secure_db_password_here
DB_ROOT_PASSWORD=your_secure_root_password_here
HOST_DB_PORT=3308

# For Local XAMPP Deployment:
# DB_HOST=127.0.0.1
# DB_PORT=3307
# DB_NAME=shivkrupa_db
# DB_USER=root
# DB_PASSWORD=

# ----------------------------------------------------------
# Razorpay Payment Gateway (Test Mode)
# ----------------------------------------------------------
# Real keys can be created at https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_YOUR_TEST_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_TEST_KEY_SECRET
RAZORPAY_TEST_MODE=true
