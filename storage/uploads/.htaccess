# ==========================================================
# SHIVKRUPA ART JEWELLERY — Uploads Security Hardening
# Disables all server-side script execution in uploaded files
# ==========================================================

<FilesMatch "\.(php|phtml|php[0-9]|phps|pl|py|cgi|sh|bash|exe)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes -ExecCGI
php_flag engine off

